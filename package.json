{
  "name": "questarr",
  "version": "1.5.0",
  "description": "A video game management application inspired by the -Arr apps. Track and organize your video game collection with automated discovery and download management.",
  "type": "module",
  "packageManager": "npm@11.7.0",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Doezer/Questarr.git"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/server/index.js",
    "check": "tsc",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css}\"",
    "secretlint": "secretlint --maskSecrets \"**/*\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/run-migrations.ts",
    "db:push": "drizzle-kit push",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.config.pg.ts",
    "db:push:pg": "drizzle-kit push --config=drizzle.config.pg.ts",
    "db:check:pg": "drizzle-kit check --config=drizzle.config.pg.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:stack": "playwright test -c playwright.stack.config.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "check:overrides": "node scripts/check-overrides.mjs",
    "audit:prod": "node scripts/audit-prod.mjs",
    "check:deprecated": "node scripts/check-deprecated-deps.mjs",
    "dev:test": "tsx scripts/clean-test-db.ts && cross-env SQLITE_DB_PATH=data/test.db PORT=5100 DISABLE_RATE_LIMITS=true npm run dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.4.1",

    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "postcss": "8.5.29",
    "prettier": "3.9.10",
    "secretlint": "^13.0.7",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --cache --cache-strategy content --cache-location node_modules/.cache/eslint",
      "prettier --cache --cache-strategy content --cache-location node_modules/.cache/prettier/.prettier-cache --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ],
    "*": [
      "secretlint --maskSecrets --no-glob"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "socket.io-parser": "4.2.7",
    "engine.io": "^6.6.10",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "qs": "^6.16.0",
    "brace-expansion": "^5.0.12",
    "minimatch": "^10.2.5",
    "fast-uri": "^3.1.8",
    "ip-address": "^10.7.2",
    "node-gyp": {
      "undici": "^6.29.0"
    },
    "eslint-plugin-react": {
      "eslint": "^10.9.1"
    },
    "fast-copy": "^4.1.0",
    "follow-redirects": "^1.16.1",
    "postcss-selector-parser": "^7.1.6",
    "body-parser": "^2.4.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "bufferutil@4.1.0": true
  }
}

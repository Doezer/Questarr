    "multer": "^2.5.0",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "node-forge": "^1.4.0",
    "parse-torrent": "^11.0.24",
    "passport": "^0.7.0",
    "passport-steam": "^1.0.18",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "re2js": "^2.8.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.14.6",
    "recharts": "^3.10.1",
    "rss-parser": "^3.13.0",
    "semver": "^7.8.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.2.5",
    "undici": "^8.12.2",
    "vaul": "^1.1.2",
    "wouter": "^3.13.0",
    "zod": "^4.6.7",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@lizenz/checker": "0.0.2",
    "@playwright/test": "^1.64.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
